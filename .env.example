# LLM. Only the key for the provider in ORVIQO_INTAKE_MODEL is required.
# Gemini (default) has a free tier, no card: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Anthropic: https://console.anthropic.com (then set ORVIQO_INTAKE_MODEL=anthropic:claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Models (Pydantic AI provider strings). The intake model may be a comma-separated
# fallback list: each next model answers when the one before is overloaded or slow.
ORVIQO_INTAKE_MODEL=google:gemini-flash-lite-latest,google:gemini-flash-latest
ORVIQO_REASONING_MODEL=anthropic:claude-opus-4-8

# Ledger database. Defaults to a local SQLite file; set Postgres in production.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/orviqo

# WhatsApp Cloud API. Leave blank to log replies instead of sending them.
# WHATSAPP_VERIFY_TOKEN: any secret you choose — must match the "Verify token"
# you enter in Meta's webhook setup. The other three come from the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# The business number as people dial it (public, not a secret). Turns on the
# /start link that redirects to a WhatsApp chat with Orviqo.
WHATSAPP_DISPLAY_NUMBER=
