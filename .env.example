# Anthropic — required. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Models (Pydantic AI provider strings). Defaults are sensible; override to experiment.
ORVIQO_INTAKE_MODEL=anthropic:claude-haiku-4-5
ORVIQO_REASONING_MODEL=anthropic:claude-opus-4-8

# Ledger database. Defaults to a local SQLite file; set Postgres in production.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/orviqo

# WhatsApp Cloud API. Leave blank to log replies instead of sending them.
# WHATSAPP_VERIFY_TOKEN: any secret you choose — must match the "Verify token"
# you enter in Meta's webhook setup. The other three come from the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
