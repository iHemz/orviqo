# Anthropic — required. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Models (Pydantic AI provider strings). Defaults are sensible; override to experiment.
ORVIQO_INTAKE_MODEL=anthropic:claude-haiku-4-5
ORVIQO_REASONING_MODEL=anthropic:claude-opus-4-8

# WhatsApp Cloud API — fill in for Week 2 (leave blank to run intake-only).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
